# ─────────────────────────────────────────────
# PLUGGY — https://pluggy.ai
# 1. Crie conta gratuita em pluggy.ai
# 2. Vá em Dashboard → API Keys
# 3. Copie o Client ID e Client Secret
# ─────────────────────────────────────────────
PLUGGY_CLIENT_ID=cole_seu_client_id_aqui
PLUGGY_CLIENT_SECRET=cole_seu_client_secret_aqui

# ─────────────────────────────────────────────
# JWT — chave secreta para autenticação
# Gere uma string aleatória longa aqui
# ─────────────────────────────────────────────
JWT_SECRET=mude_para_uma_chave_secreta_aleatoria_longa

# ─────────────────────────────────────────────
# SERVIDOR
# ─────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─────────────────────────────────────────────
# FRONTEND — URL do seu sistema HTML hospedado
# Deixe * para aceitar qualquer origem (dev)
# ─────────────────────────────────────────────
FRONTEND_URL=*
